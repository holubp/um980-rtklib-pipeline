# enabled: true
mode: ascii
expect_mode: ascii
expected_messages: GGA,RMC,GSA,GSV
family: ascii_nmea_navigation
rate_hz: 5
persistent: no
commands_active: yes
allow_reviewed_port_commands: true

CONFIG COM1 {baud}
UNLOG COM1
MODE ROVER
CONFIG MMP ENABLE
GNGGA 0.2
GNRMC 0.2
GNVTG 0.2
GNGSA 0.2
GNGSV 0.2
