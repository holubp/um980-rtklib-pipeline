# enabled: true
mode: binary
expect_mode: binary
expected_messages: BESTNAVB,OBSVMCMPB
family: binary_rawobs_solution
rate_hz: 10
persistent: no
commands_active: yes
allow_reviewed_port_commands: true

CONFIG COM1 {baud}
UNLOG COM1
MODE ROVER
CONFIG MMP ENABLE
BESTNAVB COM1 0.1
OBSVMCMPB COM1 0.1
GPSEPHB COM1 300
GLOEPHB COM1 300
GALEPHB COM1 300
BDSEPHB COM1 300
BD3EPHB COM1 300
QZSSEPHB COM1 300
