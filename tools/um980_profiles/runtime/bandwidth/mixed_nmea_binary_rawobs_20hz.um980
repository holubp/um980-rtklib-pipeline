mode: mixed
expect_mode: mixed
expected_messages: GGA,RMC,BESTNAVB,OBSVMCMPB
family: mixed_nmea_binary_rawobs
rate_hz: 20
stress: true
persistent: no
commands_active: yes
allow_reviewed_port_commands: true
