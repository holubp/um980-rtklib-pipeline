# enabled: true
mode: mixed
expect_mode: mixed
expected_messages: GGA,RMC,BESTNAVB
family: mixed_nmea_binary_solution
rate_hz: 5
persistent: no
commands_active: yes
allow_reviewed_port_commands: true

CONFIG COM1 {baud}
UNLOG COM1
MODE ROVER
CONFIG MMP ENABLE
GNGGA 0.2
GNRMC 0.2
GNVTG 0.2
BESTNAVB COM1 0.2
