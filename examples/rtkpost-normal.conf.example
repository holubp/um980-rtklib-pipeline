# RTKLIB-ex/demo5 baseline for moving-rover post-processing.
# Validate signal priorities against the generated RINEX 3 observation codes
# before treating multi-band results as production quality.
pos1-posmode =kinematic
pos1-frequency =l1+l2+l5
pos1-soltype =combined
pos1-elmask =15
pos1-navsys =61
pos1-dynamics =on
pos2-armode =continuous
pos2-gloarmode =autocal
